# Скопируйте этот файл в .env.local и заполните значения.
# Эти переменные читает только сервер. Не добавляйте префикс VITE_,
# иначе пароль попадёт в код сайта.
#
# 1. Нужен ящик на Яндексе, с которого будут уходить письма.
#    Обычный пароль от почты не подойдёт, если включена защита входа.
#    Создайте пароль приложения: https://id.yandex.ru/security/app-passwords
# 2. YANDEX_SMTP_USER — полный адрес этого ящика, например shop@yandex.ru
# 3. YANDEX_SMTP_PASSWORD — пароль приложения, не пароль от входа в Яндекс.
# 4. YANDEX_MAIL_TO — куда приходят заявки. Можно указать flowlove@gmail.com
# 5. Локально положите значения в .env.local и перезапустите npm run dev.
#    На Vercel те же имена добавьте в Settings → Environment Variables и заново опубликуйте сайт.

YANDEX_SMTP_HOST=smtp.yandex.ru
YANDEX_SMTP_PORT=465
YANDEX_SMTP_USER=
YANDEX_SMTP_PASSWORD=
YANDEX_MAIL_TO=

# Ссылка на таблицу с текстами и товарами. Доступ: «все, у кого есть ссылка, могут просматривать».
# Лист gid=0 — товары. Колонки: Ключ, Раздел, Название, Цена.
# Лист gid=1373391784 — главный экран. Колонки: Заголовок, Текст.
GOOGLE_SHEET_URL=

# Supabase. Заявки из блока «Контакты» пишутся в таблицу public.leads.
# SUPABASE_URL — Project URL из Settings → API.
# SUPABASE_SERVICE_ROLE_KEY — ключ service_role. Его читает только сервер.
# Не добавляйте префикс VITE_.
#
# Таблица:
# create table public.leads (
#   id bigint generated always as identity primary key,
#   created_at timestamptz not null default now(),
#   name text not null,
#   phone text not null,
#   email text not null,
#   message text not null default ''
# );

# Каталог читает public.products. Картинки пока файлы из public/flowers/catalog.
# create table public.products (
#   id bigint generated always as identity primary key,
#   name text not null,
#   price numeric,
#   "old price" numeric,
#   description text,
#   category_id bigint,
#   coolection_id bigint
# );
# status — пусто, «хит», «скидка» или «нет в наличии».
# Если "old price" заполнена и отличается от price, карточка показывается со скидкой.
# Кнопка «Смотреть больше» появляется, когда строк больше 9.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
